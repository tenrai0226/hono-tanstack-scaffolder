{
  "name": "tb2-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "update": "bun update && for dir in apps/*/ packages/*/; do [ -d \"$dir\" ] && (cd \"$dir\" && bun update); done",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:scraper": "turbo run dev --filter=scraper"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "eslint": "^9.39.4",
    "turbo": "latest",
    "typescript": "^5.9.3"
  }
}
