# 测试环境配置 (Scaffolder API)

NODE_ENV=test
PORT=9999
LOG_LEVEL=debug

# 必须使用独立的测试数据库连接字符串！
# 格式：postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scaffolder_test?sslmode=require

# Better Auth 测试密钥 (必须与开发环境不同)
BETTER_AUTH_SECRET=test-secret-at-least-32-chars-long-scaffolder

# 路由基础配置
APP_URL=http://localhost:3000
API_URL=http://localhost:9999

# Agent 认证测试 Token
BEARER_TOKEN=test-agent-bearer-token
