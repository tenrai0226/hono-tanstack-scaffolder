{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scaffolder-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // 以下为非机密的静态环境变量
  // 机密环境变量（如 DATABASE_URL 等）请使用 wrangler secret put 设置
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "MAINTENANCE_MODE": "false",
    "API_URL": "https://api.example.com",
    "APP_URL": "https://example.com",
    "JWKS_CACHE_TTL_SECONDS": "7200",
    "SENTRY_DSN": "https://your-sentry-dsn@sentry.io/123456"
  }
}
