{
  "name": "api",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/client/src/client.d.ts",
      "default": "./dist/client/src/client.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "dev:cloudflare": "bunx wrangler dev",
    "dev:local": "cross-env NODE_ENV=development bun run --hot src/index.ts",
    "dev": "bun run dev:local",
    "start": "bun ./dist/src/index.js",
    "db:push": "bunx drizzle-kit push",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:generate": "bunx drizzle-kit generate",
    "db:seed": "bun run src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "test": "NODE_ENV=test vitest",
    "build": "bun run build:server && bun run build:client",
    "build:server": "tsc && tsc-alias",
    "build:client": "tsc -p tsconfig.client.json && tsc-alias -p tsconfig.client.json",
    "deploy": "wrangler deploy --outdir .wrangler/dist",
    "preview": "wrangler dev",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload --release=${SENTRY_RELEASE:-$(git rev-parse HEAD)} .wrangler/dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-openapi": "^1.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "@sentry/cloudflare": "^10.50.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.6.8",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.14",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stoker": "2.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@cloudflare/workers-types": "^4.20260423.1",
    "@faker-js/faker": "^10.4.0",
    "@sentry/cli": "^3.4.1",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  }
}
